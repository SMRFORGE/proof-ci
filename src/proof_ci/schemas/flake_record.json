{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-ci.dev/schemas/v1/flake-record.json",
  "title": "FlakeRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_id",
    "status",
    "first_seen",
    "last_seen",
    "last_code_hash",
    "pass_count",
    "fail_count",
    "flip_count",
    "window",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "suspected",
        "confirmed",
        "resolved",
        "ignored"
      ]
    },
    "first_seen": {
      "type": "string"
    },
    "last_seen": {
      "type": "string"
    },
    "last_code_hash": {
      "type": "string",
      "description": "Hex SHA-256 of the inputs used to decide that this test's code was unchanged."
    },
    "pass_count": {
      "type": "integer",
      "minimum": 0
    },
    "fail_count": {
      "type": "integer",
      "minimum": 0
    },
    "flip_count": {
      "type": "integer",
      "minimum": 0
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "runs"
      ],
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reason": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
