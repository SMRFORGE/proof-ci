{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-ci.dev/schemas/v1/run-summary.json",
  "title": "RunSummary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "finished_at",
    "duration_ms",
    "selection",
    "cache",
    "counts",
    "outcome",
    "summary",
    "failures",
    "results_path"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv4 generated at the start of the run."
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "commit_sha": {
      "type": "string"
    },
    "commit_tree": {
      "type": "string",
      "description": "Git tree hash of the working tree as tested (Section 4.7, Tree hash). Copied into RunRecord.payload.commit.tree when signing."
    },
    "working_tree_dirty": {
      "type": "boolean"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "selected_count",
        "collected_count",
        "deselected_count"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "affected",
            "all",
            "explicit",
            "failed"
          ],
          "description": "failed = rerun of the tests that failed or errored in the previous run (--failed)."
        },
        "base_setting": {
          "type": "string",
          "description": "The configured or --base value before resolution: auto, HEAD, or a ref."
        },
        "base_ref": {
          "type": "string",
          "description": "The git ref actually diffed against after resolution (Section 5.8 Step 1). A full commit sha when base_setting was auto."
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected_count": {
          "type": "integer",
          "minimum": 0
        },
        "collected_count": {
          "type": "integer",
          "minimum": 0
        },
        "deselected_count": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_full_run": {
          "type": "boolean"
        },
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_suppressed_by_tree": {
          "type": [
            "string",
            "null"
          ],
          "description": "When a fallback glob matched but did not fire because the matching files are unchanged since the last run on this branch, the tree hash of that run (Section 5.8 Step 3). Null otherwise."
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hits",
        "misses",
        "disabled"
      ],
      "properties": {
        "hits": {
          "type": "integer",
          "minimum": 0
        },
        "misses": {
          "type": "integer",
          "minimum": 0
        },
        "disabled": {
          "type": "boolean"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "skipped",
        "error",
        "xfailed",
        "xpassed",
        "flaky_failures",
        "total_selected"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "xfailed": {
          "type": "integer",
          "minimum": 0
        },
        "xpassed": {
          "type": "integer",
          "minimum": 0
        },
        "flaky_failures": {
          "type": "integer",
          "minimum": 0
        },
        "total_selected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "error"
      ]
    },
    "summary": {
      "type": "string",
      "description": "One human line, e.g. '1 failed, 10 passed, 2 cache hits in 1240 ms'."
    },
    "failures": {
      "type": "array",
      "description": "Compact failure list for the summary. Full details are in results.json.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "error_type",
          "error_message",
          "file",
          "line",
          "is_flaky",
          "repro_command"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "error_type": {
            "type": "string"
          },
          "error_message": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "is_flaky": {
            "type": "boolean"
          },
          "repro_command": {
            "type": "string"
          }
        }
      }
    },
    "results_path": {
      "type": "string"
    },
    "record_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "savings_headline": {
      "type": "string",
      "description": "One-line headline, time first, money only when every applied price is configured (Section 5.12). Present after milestone M9."
    },
    "savings": {
      "$ref": "https://proof-ci.dev/schemas/v1/savings.json",
      "description": "Full savings object. Present after milestone M9; omitted before then."
    }
  }
}
